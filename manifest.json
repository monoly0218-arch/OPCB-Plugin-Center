{
  "id": "opcb.network-helper",
  "name": "OPCB 网络助手",
  "apiVersion": 1,
  "description": "查看 sing-box 连接，打开成员安装向导和管理员口令管理。",
  "host": {
    "commands": [
      {
        "id": "mac-version",
        "program": "env",
        "args": ["/usr/sbin/sysctl", "-n", "hw.optional.arm64", "kern.osproductversion"]
      },
      {
        "id": "vpn-status",
        "program": "env",
        "args": ["/usr/sbin/scutil", "--nc", "status", "SFM"]
      },
      {
        "id": "open-helper",
        "program": "env",
        "args": ["/usr/bin/open", "-b", "com.paolab.opcb-network-helper"]
      },
      {
        "id": "open-issuer",
        "program": "env",
        "args": ["/usr/bin/open", "-b", "com.paolab.opcb-password-issuer"]
      }
    ]
  }
}
