{
  "id": "opcb.muse-link",
  "name": "Muse 连接器",
  "apiVersion": 1,
  "description": "Muse 连接器 0.2.0：仅本人在所有已加入的频道、Solo 和私信提及触发，按会话原位回复。",
  "discovery": {
    "category": "agents",
    "tags": [
      "Muse",
      "Mac Link"
    ]
  },
  "host": {
    "commands": [],
    "networkOrigins": [],
    "processes": [
      {
        "id": "bridge",
        "program": "python3",
        "args": [
          "-u",
          "-c",
          "import json,sys;exec(json.loads(sys.stdin.readline()))"
        ]
      }
    ]
  }
}
